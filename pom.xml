<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lbt.construction</groupId>
    <artifactId>construction-company</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>construction-company</name>
    <description>Modular monolith for the construction company</description>

    <modules>
        <module>construction-common</module>
        <module>construction-site-management</module>
        <module>material-supply-management</module>
        <module>customer-management</module>
        <module>price-management</module>
        <module>document-management</module>
        <module>construction-application</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.4.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.lbt.construction</groupId>
                <artifactId>construction-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lbt.construction</groupId>
                <artifactId>construction-site-management</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lbt.construction</groupId>
                <artifactId>material-supply-management</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lbt.construction</groupId>
                <artifactId>customer-management</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lbt.construction</groupId>
                <artifactId>price-management</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lbt.construction</groupId>
                <artifactId>document-management</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
