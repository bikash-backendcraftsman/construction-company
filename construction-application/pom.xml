<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lbt.construction</groupId>
        <artifactId>construction-company</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>construction-application</artifactId>
    <name>construction-application</name>
    <description>Single deployable for the construction company modular monolith</description>

    <dependencies>
        <dependency>
            <groupId>com.lbt.construction</groupId>
            <artifactId>construction-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lbt.construction</groupId>
            <artifactId>construction-site-management</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lbt.construction</groupId>
            <artifactId>material-supply-management</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lbt.construction</groupId>
            <artifactId>customer-management</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lbt.construction</groupId>
            <artifactId>price-management</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lbt.construction</groupId>
            <artifactId>document-management</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>construction-company</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
